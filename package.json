  "type": "module",
  "files": ["pi/usage-bar.ts", "pi/core.ts"],
  "pi": {
    "extensions": ["./pi/usage-bar.ts"]
  },
  "scripts": {
    "test": "node --test pi/core.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
